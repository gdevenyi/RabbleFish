# systemd user unit for the local NeMo-Speech.cpp endpoint.
#
# Template: scripts/setup-endpoint.sh writes the env file that this unit reads.
# Install (see docs/endpoint.md):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/ltt-endpoint.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ltt-endpoint.service
#
# The paths below use the default prefix
# (~/.local/share/live-transcribe-translate/endpoint). For another prefix or
# XDG_DATA_HOME, change them with: systemctl --user edit --full ltt-endpoint.service

[Unit]
Description=NeMo-Speech.cpp endpoint for live-transcribe-translate (ASR, diarization, translation)
Documentation=https://github.com/gdevenyi/live-transcribe-translate/blob/master/docs/endpoint.md
After=network.target

[Service]
Type=exec
EnvironmentFile=%h/.local/share/live-transcribe-translate/endpoint/endpoint.env
# $LTT_ENDPOINT_NMT_ARGS has no braces on purpose: systemd splits it into
# "--nmt.model.path <file>", or into no arguments when it is empty
# (setup-endpoint.sh --no-translation).
ExecStart=%h/.local/share/live-transcribe-translate/endpoint/bin/nemo-speech serve \
    --asr-model ${LTT_ENDPOINT_ASR_MODEL} \
    --diar-model ${LTT_ENDPOINT_DIAR_MODEL} \
    $LTT_ENDPOINT_NMT_ARGS \
    --device ${LTT_ENDPOINT_DEVICE} \
    --host ${LTT_ENDPOINT_HOST} \
    --port ${LTT_ENDPOINT_PORT} \
    --no-ui \
    --threads ${LTT_ENDPOINT_THREADS} \
    --asr.endpointing.enable=true \
    --asr.batching.enabled=false
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
